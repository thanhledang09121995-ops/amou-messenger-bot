# Copy thành file .env khi chạy local, hoặc nhập từng biến vào Render/Railway
MESSENGER_VERIFY_TOKEN=dat-mot-chuoi-bi-mat-cua-ban
MESSENGER_PAGE_TOKEN=
# Tùy chọn: có thì bot trả lời câu hỏi tự do bằng AI, không có vẫn chạy bằng kịch bản
# Cách A - Claude (Anthropic), được ưu tiên nếu điền cả 2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Cách B - OpenAI hoặc API tương thích OpenAI (OpenRouter, Groq...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Cách C - Miễn phí, không cần key: OPENAI_BASE_URL=https://text.pollinations.ai/openai , AI_MODEL=openai
# Timeout cho gọi AI (giây), tăng lên nếu dùng provider miễn phí chậm
AI_TIMEOUT=25
# Trí nhớ hội thoại: số lượt trao đổi nhớ mỗi khách + số giờ quên khi khách im lặng
HISTORY_TURNS=6
HISTORY_TTL_HOURS=24
