# Copy thành file .env khi chạy local, hoặc nhập từng biến vào Render/Railway
MESSENGER_VERIFY_TOKEN=dat-mot-chuoi-bi-mat-cua-ban
MESSENGER_PAGE_TOKEN=
# Tùy chọn: có thì bot trả lời câu hỏi tự do bằng AI, không có vẫn chạy bằng kịch bản
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
